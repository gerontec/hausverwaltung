[Unit]
Description=Hausverwaltung: local bridge to Mayan (127.0.0.1:18095)
After=network-online.target
Wants=network-online.target

[Service]
User=gh
Group=www-data
ExecStart=/usr/bin/python3 /srv/hausverwaltung/tools/mayan_bridge.py
Restart=on-failure
RestartSec=10
MemoryMax=200M

[Install]
WantedBy=multi-user.target
